generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Plan {
  FREE
  PREMIUM
}

enum Priority {
  NORMAL
  HIGH
}

enum WishCategory {
  SHOPPING
  TRAVEL
  DATE_NIGHT
  HOME
  OTHER
}

/// A "loop" is the shared space two partners live in.
model Space {
  id               String    @id @default(cuid())
  name             String
  inviteCode       String    @unique
  plan             Plan      @default(FREE)
  premiumUntil     DateTime?
  stripeCustomerId String?   @unique
  stripeSubId      String?
  tasksCreated     Int       @default(0)
  createdAt        DateTime  @default(now())

  members       User[]
  tasks         Task[]
  wishes        Wish[]
  notifications Notification[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  color        String   @default("lagoon")
  isOwner      Boolean  @default(false)
  spaceId      String
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  createdTasks   Task[]             @relation("TaskCreator")
  assignedTasks  Task[]             @relation("TaskAssignee")
  completedTasks Task[]             @relation("TaskCompleter")
  wishes         Wish[]             @relation("WishCreator")
  fulfilling     Wish[]             @relation("WishFulfiller")
  notifications  Notification[]
  pushSubs       PushSubscription[]
}

model Task {
  id               String    @id @default(cuid())
  spaceId          String
  space            Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  title            String
  notes            String?
  dueAt            DateTime?
  hasTime          Boolean   @default(false)
  priority         Priority  @default(NORMAL)
  isPrivate        Boolean   @default(false)
  remindersEnabled Boolean   @default(true)
  createdById      String
  createdBy        User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assigneeId       String?
  assignee         User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedAt      DateTime?
  completedById    String?
  completedBy      User?     @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  reminders ReminderLog[]

  @@index([spaceId, completedAt])
  @@index([priority, completedAt, dueAt])
}

/// One row per reminder stage already sent, so cron runs never double-send.
model ReminderLog {
  id     String   @id @default(cuid())
  taskId String
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stage  String
  sentAt DateTime @default(now())

  @@unique([taskId, stage])
}

model Wish {
  id            String       @id @default(cuid())
  spaceId       String
  space         Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  category      WishCategory @default(OTHER)
  title         String
  notes         String?
  link          String?
  createdById   String
  createdBy     User         @relation("WishCreator", fields: [createdById], references: [id], onDelete: Cascade)
  fulfillerId   String?
  fulfiller     User?        @relation("WishFulfiller", fields: [fulfillerId], references: [id], onDelete: SetNull)
  fulfillingAt  DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([spaceId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId   String
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?
  taskId    String?
  wishId    String?
  urgent    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
